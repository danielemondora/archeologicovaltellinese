{
  "name": "sitoweb",
  "version": "1.0.0",
  "description": "",
  "main": ".eleventy.js",
  "scripts": {
    "11ty:build": "eleventy",
    "11ty:watch": "eleventy --watch --quiet --ignore-initial",
    "11ty": "eleventy --serve",
    "11ty:benchmark": "cross-env DEBUG=Eleventy:Benchmark* npm run build",
    "build": "cross-env NODE_ENV=production npm run 11ty:build",
    "util:rimraf": "rimraf dist",
    "util:killport": "kill-port 8787",
    "start": "npm-run-all util:rimraf util:killport 11ty:build --parallel 11ty:watch wrangler:dev",
    "wrangler:dev": "wrangler dev --live-reload",
    "wrangler:deploy": "wrangler deploy"
  },
  "keywords": [],
  "author": "Daniele Mondora",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-vite": "^8.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "kill-port": "^2.0.1",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-implicit-figures": "^0.12.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-nunjucks": "^0.2.1",
    "rimraf": "^6.1.3",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.13.0"
  }
}
