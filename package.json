{
  "name": "archeologicovaltellinese",
  "version": "1.0.0",
  "description": "Sito Web realizzato per l'Istituto Archeologico Valtellinese",
  "main": ".eleventy.js",
  "scripts": {
    "clean": "rimraf dist",
    "util:killport": "kill-port 8787",
    "build:11ty": "cross-env NODE_ENV=production eleventy",
    "build:pagefind": "pagefind --site dist",
    "build": "npm run build:11ty && npm run build:pagefind",
    "watch": "eleventy --watch --quiet",
    "start": "npm-run-all clean util:killport build --parallel watch wrangler:dev",
    "wrangler:dev": "wrangler dev --live-reload",
    "deploy": "npm run build && wrangler deploy"
  },
  "keywords": [],
  "author": "Daniele Mondora",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-vite": "^8.0.0",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "kill-port": "^2.0.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-implicit-figures": "^0.12.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-nunjucks": "^0.2.1",
    "rimraf": "^6.1.4",
    "wrangler": "^4.158.0"
  }
}
