{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "archeologicovaltellinese",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,

  // Serve the Eleventy build output as static assets
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  
  // Run the site build before publishing via `wrangler deploy`
  "build": {
    "command": "npm run build"
  }
}