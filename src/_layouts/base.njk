{% set assetHash = global.random() %}

<!DOCTYPE html>
<html lang="{{ lang | default('it') }}">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {% include "partials/meta-head.njk" %}

  <!-- Custom CSS e JS -->
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/bundle.js" defer></script>

  <link rel="stylesheet" href="https://ka-f.webawesome.com/webawesome@3.13.0/styles/themes/default.css" />
  <script type="module" src="https://ka-f.webawesome.com/webawesome@3.13.0/webawesome.loader.js"></script>

</head>

<body id="top">

  <div class="site-wrap">
    
    {% include "partials/header.njk" %}
    
    {% block content %}
    {% if content %}
    {{ content | safe }}
    {% endif %}
    {% endblock %}

    {% include "partials/footer.njk" %}
  </div>

  <a href="#top" class="back-to-top" aria-label="Torna in cima">
