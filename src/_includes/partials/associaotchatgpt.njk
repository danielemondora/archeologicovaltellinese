<section class="associati" id="associati" aria-labelledby="associati-title">
  <div class="associati__inner flow">

    <header class="associati__header flow">
      <p class="associati__eyebrow">Istituto Archeologico Valtellinese</p>

      <h2 id="associati-title">Diventa socio dell'Istituto</h2>

      <p class="associati__intro">
        Entrare a far parte dell'{{ site.name }} è semplice.
        Compila il modulo qui sotto e invia la tua richiesta di associazione.
      </p>
    </header>

    <div class="associati__info">

      <div class="associati__card">
        <h3>Quota associativa annuale</h3>

        <dl class="associati__quote">
          <div>
            <dt>Socio ordinario</dt>
            <dd>25&nbsp;€</dd>
          </div>

          <div>
            <dt>Socio sostenitore</dt>
            <dd>30&nbsp;€</dd>
          </div>
        </dl>
      </div>

      <div class="associati__card">
        <h3>Come pagare</h3>

        <p>
          Puoi versare la quota durante gli eventi organizzati
          dall'Istituto, in occasione dell'Assemblea oppure tramite
          bonifico bancario.
        </p>

        <p class="associati__iban">
          <strong>IBAN</strong><br>
          <span>{{ site.company.iban }}</span>
        </p>

        <p class="associati__bank">
          Credit Agricole
        </p>
      </div>

    </div>

    <div class="associati__form-wrapper">

      <div class="associati__form-header">
        <h3>Invia la tua richiesta</h3>
        <p>
          Compila tutti i campi obbligatori contrassegnati.
        </p>
      </div>

      <form
        id="form-associati"
        class="form-associati flow"
        novalidate
      >

        <div class="form-associati__grid">

          <wa-input
            id="nome"
            name="nome"
            label="Nome"
            required
            placeholder="Mario"
            autocomplete="given-name"
          ></wa-input>

          <wa-input
            id="cognome"
            name="cognome"
            label="Cognome"
            required
            placeholder="Rossi"
            autocomplete="family-name"
          ></wa-input>

          <wa-input
            id="indirizzo"
            name="indirizzo"
            label="Indirizzo di residenza"
            required
            placeholder="Via Roma 1, 23100 Sondrio (SO)"
            autocomplete="street-address"
          ></wa-input>

          <wa-input
            type="date"
            id="data-nascita"
            name="data-nascita"
            label="Data di nascita"
            required
            autocomplete="bday"
          ></wa-input>

          <wa-input
            id="cf"
            name="cf"
            label="Codice fiscale"
            required
            pattern="[A-Za-z0-9]{16}"
            maxlength="16"
            minlength="16"
            placeholder="RSSMRA92S08F205F"
            autocomplete="off"
            spellcheck="false"
            autocapitalize="characters"
            aria-describedby="cf-help"
          ></wa-input>

          <div class="form-associati__full">
            <p id="cf-help" class="form-associati__help">
              Inserisci il codice fiscale composto da 16 caratteri.
            </p>
          </div>

          <div class="form-associati__full">
            <wa-textarea
              id="note"
              name="note"
              label="Note"
              rows="4"
              placeholder="Lasciaci un messaggio (facoltativo)"
            ></wa-textarea>
          </div>

        </div>

        <div class="form-associati__privacy">
          <p>
            I dati forniti saranno utilizzati per gestire la richiesta
            di associazione. Prima dell'invio, consulta
            <a href="/privacy-policy">
              l'informativa sulla privacy
            </a>.
          </p>
        </div>

        <div
          id="form-feedback"
          class="form-associati__feedback"
          role="status"
          aria-live="polite"
          hidden
        ></div>

        <div class="form-associati__actions">
          <wa-button
            type="submit"
            variant="primary"
            size="large"
          >
            Invia richiesta
          </wa-button>
        </div>

      </form>

    </div>

    <aside class="associati__alternative">
      <h3>Preferisci scrivere direttamente?</h3>

      <p>
        Puoi anche inviare i tuoi dati via email a
        <a href="mailto:{{ site.contact.email }}">
          {{ site.contact.email }}
        </a>.
      </p>
    </aside>

  </div>
</section>


<style>
  /* =========================================================
     ASSOCIATI
     ========================================================= */

  .associati {
    --associati-border: color-mix(
      in srgb,
      currentColor 15%,
      transparent
    );

    --associati-surface: color-mix(
      in srgb,
      currentColor 4%,
      transparent
    );

    --associati-surface-strong: color-mix(
      in srgb,
      currentColor 7%,
      transparent
    );

    padding-block: clamp(4rem, 8vw, 7rem);
  }


  .associati__inner {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
  }


  /* Header
     --------------------------------------------------------- */

  .associati__header {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }


  .associati__eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }


  .associati__header h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.05;
    text-wrap: balance;
  }


  .associati__intro {
    max-width: 42rem;
    margin-inline: auto;
    font-size: 1.08rem;
    line-height: 1.7;
    opacity: 0.8;
    text-wrap: pretty;
  }


  /* Information cards
     --------------------------------------------------------- */

  .associati__info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 62rem;
    margin: clamp(2rem, 5vw, 3.5rem) auto;
  }


  .associati__card {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--associati-border);
    border-radius: 1rem;
    background: var(--associati-surface);
  }


  .associati__card h3 {
    margin-block: 0 1rem;
    font-size: 1.1rem;
  }


  .associati__card p {
    margin-block: 0;
    line-height: 1.65;
  }


  .associati__quote {
    margin: 0;
  }


  .associati__quote > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--associati-border);
  }


  .associati__quote > div:first-child {
    padding-top: 0;
  }


  .associati__quote > div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }


  .associati__quote dt {
    font-weight: 500;
  }


  .associati__quote dd {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }


  .associati__iban {
    margin-top: 1.25rem !important;
    padding: 0.9rem 1rem;
    border-radius: 0.65rem;
    background: var(--associati-surface-strong);
    overflow-wrap: anywhere;
  }


  .associati__iban span {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco,
      Consolas, "Liberation Mono", monospace;
    font-size: 0.9rem;
  }


  .associati__bank {
    margin-top: 0.75rem !important;
    font-size: 0.9rem;
    opacity: 0.7;
  }


  /* Form
     --------------------------------------------------------- */

  .associati__form-wrapper {
    width: min(100%, 62rem);
    margin-inline: auto;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--associati-border);
    border-radius: 1.25rem;
    background: var(--associati-surface);
  }


  .associati__form-header {
    margin-bottom: 2rem;
  }


  .associati__form-header h3 {
    margin: 0 0 0.35rem;
    font-size: 1.4rem;
  }


  .associati__form-header p {
    margin: 0;
    opacity: 0.7;
  }


  .form-associati {
    --flow-space: 1.5rem;
  }


  .form-associati__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }


  .form-associati__grid > wa-input {
    min-width: 0;
  }


  .form-associati__grid > wa-input:nth-child(3) {
    grid-column: 1 / -1;
  }


  .form-associati__full {
    grid-column: 1 / -1;
  }


  .form-associati__help {
    margin: -0.75rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    opacity: 0.65;
  }


  .form-associati__privacy {
    padding-top: 0.25rem;
    border-top: 1px solid var(--associati-border);
  }


  .form-associati__privacy p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    opacity: 0.75;
  }


  .form-associati__privacy a,
  .associati__alternative a {
    text-underline-offset: 0.2em;
  }


  .form-associati__actions {
    display: flex;
    justify-content: flex-end;
  }


  /* Feedback
     --------------------------------------------------------- */

  .form-associati__feedback {
    padding: 0.9rem 1rem;
    border: 1px solid var(--associati-border);
    border-radius: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }


  .form-associati__feedback[data-type="error"] {
    border-color: currentColor;
  }


  .form-associati__feedback[data-type="success"] {
    border-color: currentColor;
  }


  /* Alternative contact
     --------------------------------------------------------- */

  .associati__alternative {
    max-width: 62rem;
    margin: 1rem auto 0;
    padding: 1.25rem 1.5rem;
    text-align: center;
    border-radius: 1rem;
    background: var(--associati-surface);
  }


  .associati__alternative h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }


  .associati__alternative p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.75;
  }


  /* Responsive
     --------------------------------------------------------- */

  @media (max-width: 700px) {

    .associati__info {
      grid-template-columns: 1fr;
    }


    .form-associati__grid {
      grid-template-columns: 1fr;
    }


    .form-associati__grid > wa-input:nth-child(3),
    .form-associati__full {
      grid-column: auto;
    }


    .form-associati__actions {
      justify-content: stretch;
    }


    .form-associati__actions wa-button {
      width: 100%;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .associati *,
    .associati *::before,
    .associati *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }

  }
</style>


<script>
  (() => {
    const form = document.getElementById('form-associati');
    const feedback = document.getElementById('form-feedback');
    const cfInput = document.getElementById('cf');

    if (!form) return;


    /*
     * Normalizza il codice fiscale:
     * - rimuove eventuali spazi
     * - converte in maiuscolo
     */
    cfInput?.addEventListener('input', () => {
      cfInput.value = cfInput.value
        .replace(/\s/g, '')
        .toUpperCase();
    });


    function showFeedback(message, type) {
      feedback.hidden = false;
      feedback.dataset.type = type;
      feedback.textContent = message;
    }


    function hideFeedback() {
      feedback.hidden = true;
      feedback.textContent = '';
      delete feedback.dataset.type;
    }


    form.addEventListener('submit', (event) => {
      event.preventDefault();
      hideFeedback();


      /*
       * Lasciamo agli elementi Shoelace/Web Awesome
       * la gestione visiva della validazione.
       */
      if (!form.checkValidity()) {
        showFeedback(
          'Controlla i campi obbligatori prima di inviare la richiesta.',
          'error'
        );

        form.reportValidity();

        return;
      }


      const emailDestinazione =
        '{{ site.contact.email }}';


      const nome =
        document.getElementById('nome').value.trim();

      const cognome =
        document.getElementById('cognome').value.trim();

      const indirizzo =
        document.getElementById('indirizzo').value.trim();

      const cf =
        document.getElementById('cf').value.trim().toUpperCase();

      const dataNascitaRaw =
        document.getElementById('data-nascita').value;

      const note =
        document.getElementById('note').value.trim();


      let dataNascitaFormat = '';

      if (dataNascitaRaw) {
        const [anno, mese, giorno] =
          dataNascitaRaw.split('-');

        dataNascitaFormat =
          `${giorno}/${mese}/${anno}`;
      }


      const subject =
        `Richiesta associazione: ${nome} ${cognome}`;


      const body = [
        "Salve,",
        "",
        "vorrei inviare la mia richiesta di associazione all'Istituto Archeologico Valtellinese.",
        "",
        "DATI PERSONALI",
        `Nome: ${nome}`,
        `Cognome: ${cognome}`,
        `Indirizzo: ${indirizzo}`,
        `Data di nascita: ${dataNascitaFormat}`,
        `Codice fiscale: ${cf}`,
        "",
        "NOTE",
        note || "Niente da aggiungere.",
        "",
        "Grazie."
      ].join('\n');


      const mailto =
        `mailto:${encodeURIComponent(emailDestinazione)}` +
        `?subject=${encodeURIComponent(subject)}` +
        `&body=${encodeURIComponent(body)}`;


      /*
       * Mostriamo un piccolo feedback prima di aprire
       * il client email.
       */
      showFeedback(
        'Stiamo preparando la richiesta di associazione…',
        'success'
      );


      window.location.href = mailto;
    });
  })();
</script>
