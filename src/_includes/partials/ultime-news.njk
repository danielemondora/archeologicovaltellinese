<section class="flow">
  <div class="wrapper">
    <header class="repel">
      <h2>Ultime news</h2>
      <a href="/news/">Tutte le news</a>
    </header>
  </div>

  <div class="wrapper">
    <div class="grid">

      {% for item in collections.news %}
      {% if loop.index <= 3 %}
      
      <article class="card | flow">

        {# HEADER #}
        <header class="flow">

          <p class="text-step--1 text-muted">
            <time datetime="{{ item.date | htmlDateFilter }}">
              {{ item.date | dateFilter }}
            </time>
          </p>

          <h3>
            <a class="" href="{{ item.url }}">
              {{ item.data.title }}
            </a>
          </h3>

        </header>

        {# DESCRIZIONE #}
        {% if item.data.description %}

        <p>{{ item.data.description }}</p>

        {% endif %}

        {# LINK #}
        <div class="cluster">
          <a href="{{ item.url }}">
            Leggi la news
          </a>
        </div>

      </article>
      
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>