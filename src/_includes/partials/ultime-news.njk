<section class='wrapper'>
  <div class='flow flow-space-s'>
    <header class='repel'>
      <h2 class='text-step-3'>Ultime News</h2>
      <a href='/news/'>Tutte le news</a>
    </header>

    <div class='grid'>

      {% for item in collections.news %}
        {% if loop.index <= 3 %}
          {% include "partials/news-card.njk" %}
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>
