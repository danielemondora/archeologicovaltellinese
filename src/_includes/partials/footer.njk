<footer class="site-footer | text-on-primary">

  <section class="site-footer__main">
    <div class="wrapper" data-variant="large">
      <div class="grid" data-layout="thirds">

        <header>
          <h2 class="weight-bold text-step-2">{{ site.name }}</h2>
          <p class="text-step--1">{{ site.description }}</p>
        </header>

        <div>
          <h3>Sede</h3>
          <div class="text-step--1">
            <ul role="list" class="flow flow-space-3xs | text-step--1">
              <li>{{ site.address.street }}</li>
              <li>{{ site.address.postalCode }} {{ site.address.city }}</li>
              <li>C.F. {{site.company.codiceFiscale }} </li>
            </ul>
          </div>
        </div>

        <div>
          <h3>Contatti</h3>
          <div class="text-step--1">
            <ul role="list" class="flow text-step--1">
              <li>
                <a class="" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
              </li>
              <li>
                <a class="" href="{{ site.social.facebook }}">Vai alla pagina Facebook</a>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="site-footer__bottom | text-step--2">
    <div class="wrapper" data-variant="large">
      <span>
        Sito Web realizzato da
        <a href="mailto:{{- site.author.email -}}" class="weight-bold">{{- site.author.name-}}</a>
      </span>
      <div class="cluster">
        <a class="" href="/privacy-policy/">Privacy Policy</a>
        <a class="" href="/contatti/">Contatti</a>
      </div>
    </div>
  </section>

</footer>
