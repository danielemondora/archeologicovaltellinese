<footer class="footer | bg-footer | text-on-primary">
  <div class="wrapper" data-variant='large'>
    <div class="flow">

      <h3 class="weight-bold">{{ site.name }}</h3>

      <div class="footer-address">
        <ul role="list">
          <li>{{ site.address.street }}</li>
          <li>{{ site.address.postalCode }}&nbsp;{{ site.address.city }}</li>
          <li>C.F. {{site.company.codiceFiscale }} </li>
        </ul>
      </div>

      <div class="footer__contact">
        <span>Email: <a href="mailto:{{ site.contact.email }}" class="">{{ site.contact.email }}</a></span>
      </div>
      
      <div class="copyright">
        <p>Copyright &copy; {% year %} - {{ site.name }}</p>
        <p class="text-step--1">Sito web realizzato da <a href="mailto:{{- site.author.email -}}">{{- site.author.name -}}</a></p>
      </div>

    </div>
  </div>
</footer>