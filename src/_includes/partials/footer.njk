<footer class='site-footer | text-on-primary'>

  <section>
    <div class='wrapper' data-variant='large'>
      <div class='site-footer__grid'>

        <header>
          <h2 class='text-step-2'>{{ site.name }}</h2>
          <p class='text-step--1'>{{ site.description }}</p>
        </header>

        <div>
          <h3 class='text-step-1'>Sede</h3>
          <div class='text-step--1'>
            <ul class='flow flow-space-3xs | text-step--1' role='list'>
              <li>{{ site.address.street }}</li>
              <li>{{ site.address.postalCode }} {{ site.address.city }}</li>
              <li>C.F. {{ site.company.codiceFiscale }}</li>
            </ul>
          </div>
        </div>

        <div>
          <h3 class='text-step-1'>Contatti</h3>
          <div class='text-step--1'>
            <ul class='flow flow-space-3xs | text-step--1' role='list'>
              <li>
                <a class='' href='mailto:{{ site.contact.email }}'>
                  {{ site.contact.email }}
                </a>
              </li>
              <li>
                <a class='' href='{{ site.social.facebook }}'>
                  Vai alla pagina Facebook
                </a>
              </li>
              <li>
                <a class='' href='/contatti/'>Tutti i Contatti</a>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class='text-step--2 | text-on-primary'>
    <div class='wrapper | cluster' data-variant='large'>
      <span>
        Sito Web realizzato da
        <a class='weight-bold' href='{{- site.author.site -}}'>
          {{- site.author.name -}}
        </a>
      </span>
      <a class='' href='/privacy-policy/'>Privacy Policy</a>
    </div>
  </section>

</footer>
