    fetchpriority="high" loading="eager" />

  <div class="wrapper" data-variant="large">

    <div class="hero__content | flow">

      <h1 class="weight-bold text-step-5">
        Un viaggio nel tempo nel cuore delle Alpi
      </h1>

      <p class="text-step-1">
        {{ site.description }}
      </p>

      <div class="cluster">

        <a class="button" href="/storia/" data-button-variant="primary">
