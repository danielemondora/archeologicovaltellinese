<header class="hero content-grid full-width text-on-primary">

  <img class="hero__bg-image | full-width" src="../assets/images/hero.jpg" alt="{{ hero.imageAlt }}" fetchpriority=high loading=eager
    sizes="100vw">
  <div class="hero__overlay | full-width"></div>

  <div class="hero__content | cluster" style="--cluster-horizontal-alignment: center">
    <h1>{{ site.name }}</h1>
    <p>{{ site.description }}</p>
    <div class="hero__actions">
      <a href="#associati" class="button">Diventa Socio</a>
    </div>
  </div>

</header>

<style>
.hero {
  position: relative;
  isolation: isolate; 
  min-height: 60vh;
  align-content: center; 
}

.hero__bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -2;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background-color: rgb(0 0 0 / 0.5);
  z-index: -1;
}
</style>