<section
  class='notiziario-search flow'
  aria-labelledby='notiziario-search-title'
>

  <!--<div class='notiziario-search__intro flow'>
    <h2 id='notiziario-search-title'>Cerca nell'archivio</h2>

    <p>
      Cerca articoli, autori e contenuti pubblicati nei volumi del Notiziario.
    </p>
  </div>-->

  <pagefind-config
    lang='it'
    excerpt-length='35'
    faceted
    preload
  ></pagefind-config>

  <div class='notiziario-search__trigger'>
    <pagefind-modal-trigger placeholder='Cerca...'></pagefind-modal-trigger>
  </div>

  <pagefind-modal reset-on-close>

    <pagefind-modal-header>
      <pagefind-input placeholder='Cerca...' debounce='250'></pagefind-input>
    </pagefind-modal-header>

    <pagefind-modal-body>
      <div class='notiziario-search__layout'>

        <aside class='notiziario-search__filters'>
          <!--<h3 class='notiziario-search__filters-title'>Filtra i risultati</h3>-->
          <pagefind-filter-pane sort='alphabetical'></pagefind-filter-pane>
        </aside>

        <div class='notiziario-search__results flow'>
          <pagefind-summary></pagefind-summary>
          <pagefind-results show-images='true'></pagefind-results>
        </div>

      </div>
    </pagefind-modal-body>

    <pagefind-modal-footer>
      <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>

  </pagefind-modal>

</section>

<style>
  .notiziario-search {
    --pf-text: var(--text-main);
    --pf-text-secondary: var(--text-muted);
    --pf-text-muted: var(--text-muted);
    --pf-background: var(--bg-surface);
    --pf-border: var(--border-default);
    --pf-border-focus: var(--border-strong);
    --pf-hover: var(--bg-surface-subtle);
    --pf-outline-focus: var(--color-focus);
    --pf-font: var(--font-base);
    --pf-border-radius: var(--border-radius);

    --pf-modal-max-width: 64rem;
    --pf-modal-max-height: min(85dvh, 900px);
    --pf-modal-top: 5dvh;
  }

  .notiziario-search__layout {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--space-m);
    min-width: 0;
  }

  .notiziario-search__filters {
    min-width: 0;
    align-self: start;
  }

  .notiziario-search__filters-title {
    margin: 0 0 var(--space-xs);

    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text-main);
  }

  .notiziario-search__results {
    min-width: 0;
  }

  @media (max-width: 48rem) {
    .notiziario-search__trigger {
      max-width: none;
    }

    .notiziario-search__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
