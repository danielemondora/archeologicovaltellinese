<section class='associati__form-wrapper | box flow'>

  <header class='associati__form-header'>
    <h2>Contattaci</h2>
    <p>Compila tutti i campi obbligatori contrassegnati.</p>
  </header>

  <form id='form-associati' class='form-associati | flow'>

    <div class='grid'>
      <wa-input
        id='nome'
        name='nome'
        label='Nome'
        required
        placeholder='Mario'
      ></wa-input>
      <wa-input
        id='cognome'
        name='cognome'
        label='Cognome'
        required
        placeholder='Rossi'
      ></wa-input>
    </div>

    <div>
      <wa-input
        id='indirizzo'
        name='indirizzo'
        label='Indirizzo di Residenza'
        required
        placeholder='Via Roma 1, 23100 Sondrio (SO)'
      ></wa-input>
    </div>

    <div class='grid'>
      <wa-input
        id='data-nascita'
        type='date'
        name='data-nascita'
        label='Data di Nascita'
        required
      ></wa-input>
      <wa-input
        id='cf'
        name='cf'
        label='Codice Fiscale'
        required
        pattern='[a-zA-Z0-9]{16}'
        placeholder='RSSMRA92S08F205F'
        autocapitalize='characters'
      ></wa-input>
    </div>

    <wa-textarea
      id='note'
      name='note'
      label='Note'
      rows='4'
      placeholder='Lasciaci un messaggio'
    ></wa-textarea>

    <button class='button' type='submit'>Invia Richiesta</button>
  </form>

  <div class='form-associati__privacy'>
    <p class='text-step--2'>
      Cliccando su Invia, si aprirà il tuo client di posta elettronica con i dati precompilati. I dati non vengono salvati su questo sito. Leggi la nostra
      <a href='/privacy-policy/'>Privacy Policy</a>.
    </p>
  </div>

</section>
