<article class="card">

  {# HEADER #}
  <header class="flow flow-space-3xs">

    <p class="text-step--1 text-muted">
      <span class="visually-hidden">Pubblicato il: </span>
      <time datetime="{{ item.date | htmlDateFilter }}">
        {{ item.date | dateFilter }}
      </time>
    </p>

    <h3>
      <a class="" href="{{ item.url }}">
        {{ item.data.title }}
      </a>
    </h3>

  </header>

  {# DESCRIZIONE #}
  {% if item.data.description %}

  <p>{{ item.data.description }}</p>

  {% endif %}

  {# LINK #}
  <div>
    <a class="button" href="{{ item.url }}" aria-hidden="true" tabindex="-1">
      Leggi
    </a>
  </div>

</article>