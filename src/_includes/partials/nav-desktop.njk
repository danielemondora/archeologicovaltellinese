<nav class='desktop-nav' aria-label='Navigazione principale'>
  <ul class='repel' role='list'>

    {% for item in navigation.items %}
      {% if item.children and item.children.length %}
        <li class='nav-item'>
          <!-- Trigger -->
          <button
            class='dropdown-trigger | btn-reset'
            popovertarget='desktop-menu-{{ loop.index }}'
          >
            {{ item.text }}

            {% include "svg/chevron-down-solid-full.svg" %}

          </button>

          <!-- Pannello Popover -->
          <div
            id='desktop-menu-{{ loop.index }}'
            class='desktop-dropdown__panel'
            popover
          >
            <ul class='flow' role='list'>
              {% for child in item.children %}
                {% set isChildCurrent =(
                    child.url == '/' and page.url == '/'
                  ) or(
                    child.url != '/' and page.url and page.url.startsWith(
                      child.url
                    )
                  )
                %}
                <li>
                  <a
                    class=''
                    href='{{ child.url }}'
                    {% if isChildCurrent %}
                      aria-current="page"
                    {% endif %}
                  >{{ child.text }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </li>
      {% else %}
        <li class='nav-item'>
          <a
            class=''
            href='{{ item.url }}'
            {% if page.url==item.url %}
              aria-current="page"
            {% endif %}
          >{{ item.text }}</a>
        </li>
      {% endif %}
    {% endfor %}
    <li>
      <a
        class='nav-search-btn'
        href='/archivio/'
        aria-label='Cerca nell&apos;archivio'
      >{% include "svg/magnifying-glass-solid-full.svg" %}</a>
    </li>
  </ul>
</nav>
