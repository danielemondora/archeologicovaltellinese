<nav class="desktop-nav" aria-label="Navigazione principale">
  <ul role="list" class="repel">

    {% for item in navigation.items %}

    {% if item.children and item.children.length %}
    <li class="nav-item">
      <!-- Trigger -->
      <button popovertarget="desktop-menu-{{ loop.index }}" class="dropdown-trigger | btn-reset">
        {{ item.text }}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true" width="1em"
          height="1em"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
          <path
            d="M297.4 470.6C309.9 483.1 330.2 483.1 342.7 470.6L534.7 278.6C547.2 266.1 547.2 245.8 534.7 233.3C522.2 220.8 501.9 220.8 489.4 233.3L320 402.7L150.6 233.4C138.1 220.9 117.8 220.9 105.3 233.4C92.8 245.9 92.8 266.2 105.3 278.7L297.3 470.7z" />
        </svg>
      </button>

      <!-- Pannello Popover -->
      <div id="desktop-menu-{{ loop.index }}" popover class="desktop-dropdown__panel">
        <ul role="list" class="flow">
          {% for child in item.children %}
          <li><a href="{{ child.url }}" {% if page.url==child.url %}aria-current="page" {% endif %}>{{
              child.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </li>

    {% else %}
    <li class="nav-item">
      <a class="" href="{{ item.url }}" {% if page.url==item.url %}aria-current="page" {% endif %}>
        {{item.text }}
      </a>
    </li>
    {% endif %}
    {% endfor %}
  </ul>

  
</nav>