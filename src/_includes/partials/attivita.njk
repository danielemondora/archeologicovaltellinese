<section class='wrapper'>

  <div class='flow flow-space-s'>
    <header class='flow'>
      <h2 class='text-step-3'>{{- home.accordion.title -}}</h2>
      <div>
        <p>{{- home.accordion.text -}}</p>
      </div>
    </header>

    <div class='flow'>
      {% for item in home.accordion.items %}
        <article>
          <details class='accordion'>

            <summary>
              <div class='splitter'>
                <h3 class='text-step-1'>{{- item.title -}}</h3>
                {% include "svg/chevron-down-solid-full.svg" %}
              </div>
            </summary>

            <div class='accordion-content'>
              <div
                class='switcher | py-s'
                {% if loop.index0 % 2 == 1 %}
                  data-direction="reverse"
                {% endif %}
              >
                <img src='{{ item.image }}' alt='{{ item.alt }}' />
                <p class='text-muted'>{{- item.text -}}</p>
              </div>
            </div>

          </details>
        </article>
      {% endfor %}
    </div>
  </div>

</section>
