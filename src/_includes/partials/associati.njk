<section class="associati" id="associati" aria-labelledby="associati-title">
  <div class="flow">

    <header>
      <h2 id="associati-title">Diventa Socio dell'Istituto</h2>
      <p class="associati__intro">
        Entrare a far parte dell'{{ site.name }} è semplice.
        Compila il modulo qui sotto e invia la tua richiesta di associazione.
      </p>
    </header>

    <div class="associati__info | cluster">

      <div class="associati__card">
        <h3>Quota Annuale</h3>
        <dl>
          <div>
            <dt>Socio ordinario</dt>
            <dd>25&nbsp;€</dd>
          </div>
          <div>
            <dt>Socio sostenitore</dt>
            <dd>30&nbsp;€</dd>
          </div>
        </dl>
      </div>

      <div class="associati__card">
        <h3>Come Pagare</h3>
        <p>
          Puoi versare la quota durante gli eventi organizzati
          dall'Istituto, in occasione dell'Assemblea oppure tramite
          bonifico bancario.
        </p>

        <p>
          <strong>IBAN</strong><br>
          <span>{{ site.company.iban }}</span>
        </p>

      </div>
    </div>

    <div class="associati__form-wrapper | flow">

      <header>
        <h3>Invia la tua richiesta</h3>
        <p>
          Compila tutti i campi obbligatori contrassegnati.
        </p>
      </header>

      <form id="form-associati" class="form-associati flow">

        <wa-input id="nome" name="nome" label="Nome" required placeholder="Mario"></wa-input>

        <wa-input id="cognome" name="cognome" label="Cognome" required placeholder="Rossi"></wa-input>

        <wa-input id="indirizzo" name="indirizzo" label="Indirizzo di Residenza" required
          placeholder="Es. Via Roma 1, 23100 Sondrio (SO)"></wa-input>

        <wa-input type="date" id="data-nascita" name="data-nascita" label="Data di Nascita" required></wa-input>

        <wa-input id="cf" name="cf" label="Codice Fiscale" required pattern="[a-zA-Z0-9]{16}"
          placeholder="RSSMRA92S08F205F" autocapitalize="characters"></wa-input>

        <wa-textarea id="note" name="note" label="Note" rows="4" placeholder="Lasciaci un messaggio"></wa-textarea>

        <wa-button type="submit" variant="primary">Invia Richiesta</wa-button>

        <div class="form-associati__privacy">
          <p>
            I dati forniti saranno utilizzati per gestire la richiesta
            di associazione. Prima dell'invio, consulta
            <a href="/privacy-policy">
              l'informativa sulla privacy
            </a>.
          </p>
        </div>

      </form>
    </div>

    <aside class="associati__alternative">
      <h3>Preferisci scrivere direttamente?</h3>

      <p>
        Puoi anche inviare i tuoi dati via email a
        <a href="mailto:{{ site.contact.email }}">
          {{ site.contact.email }}
        </a>
      </p>
    </aside>

  </div>
</section>

<script>
  document.getElementById('form-associati').addEventListener('submit', function (event) {
    event.preventDefault();

    const emailDestinazione = 'info@archeologicovaltellinese.it';

    const nome = document.getElementById('nome').value;
    const cognome = document.getElementById('cognome').value;
    const indirizzo = document.getElementById('indirizzo').value;
    const cf = document.getElementById('cf').value;
    const dataNascitaRaw = document.getElementById('data-nascita').value;
    let dataNascitaFormat = '';
    if (dataNascitaRaw) {
      const [anno, mese, giorno] = dataNascitaRaw.split('-');
      dataNascitaFormat = `${giorno}/${mese}/${anno}`;
    }
    const note = document.getElementById('note').value;

    const subject = `Richiesta Associazione: ${nome} ${cognome}`;

    const body = `Salve, vorrei inviare la mia richiesta di associazione all'Istituto Archeologico Valtellinese.

    Dati Personali:
    Nome: ${nome}
    Cognome: ${cognome}
    Indirizzo: ${indirizzo}
    Data di Nascita: ${dataNascitaFormat}
    Codice Fiscale: ${cf}

    Note:
    ${note || 'Niente da aggiungere.'}`;

    window.location.href = `mailto:${emailDestinazione}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>