<header class="site-header | content-grid | py-s">
  <div class="breakout | repel">

    <nav id="main-nav" aria-label="Navigazione principale">
      <ul role="list" class="cluster">
        {% for item in navigation.items %}
        {% if item.children and item.children.length %}

        <!-- ELEMENTI CON CHILDREN DROPDOWN -->
        <li>
          <wa-dropdown>
            <wa-button appearance="plain" slot="trigger" with-caret class="text-step-0">{{ item.text
              }}</wa-button>
            {% for item in item.children %}
            <wa-dropdown-item href="{{ item.url }}" class="text-step-0">{{ item.text }}</wa-dropdown-item>
            {% endfor %}
          </wa-dropdown>
        </li>

        {% else %}

        <!-- ELEMENTI SINGOLI -->
        <li>
          <a class="site-nav__link" href="{{ item.url }}" {% if page.url==item.url %}aria-current="page" {% endif %}>
            {{ item.text }}
          </a>
        </li>

        {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div>
      <wa-button variant="brand" pill href="#associati">Diventa Socio</wa-button>
    </div>

  </div>
</header>