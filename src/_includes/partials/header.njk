<header class='site-head' role='banner'>
  <a class='skip-link' href='#main-content'>Vai al contenuto principale</a>

  <div class='wrapper | py-s' data-variant='large'>
    <div class='splitter'>

      <a class='site-head__brand' href='/'>
        <img
          eleventy:formats='svg'
          height='64'
          src='/assets/favicon/favicon.svg'
          alt='{{ site.name }}'
          fetchpriority='high'
          loading='eager'
        />
      </a>

      <div>

        {# Navigazione Desktop #}
        {% include "partials/nav-desktop.njk" %}

        {# Navigazione Mobile #}
        {% include "partials/nav-mobile.njk" %}

      </div>

    </div>
  </div>
</header>
