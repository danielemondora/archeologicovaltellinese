<header class="site-head | bg-primary | text-on-primary" role="banner">
  <a href="#main-content" class="skip-link">Vai al contenuto principale</a>
  <div class="wrapper | py-s" data-variant='large'>
    <div class="site-head__inner | splitter">
      <a href="/" aria-label="Istituto Archeologico Valtellinese Home" class="site-head__brand">
        <span>IAV</span>
      </a>
      <div>
        <nav class="navigation" aria-label="primary">
          <ul role="list" class="repel">
            {% for item in navigation.items %}
            {% if item.children and item.children.length %}
            <li><button popovertarget="{{- item.text -}}_panel" type="button">{{- item.text -}}</button></li>
            <div id="{{- item.text -}}_panel" popover>
              <ul role="list">
                {% for item in item.children %}
                <li><a href="{{ item.url }}" class="" {% if page.url==item.url %}aria-current="page" {% endif %}>{{ item.text }}</a></li>
                {% endfor %}
              </ul>              
            </div>
            {% else %}
            <li><a href="{{ item.url }}" class="" {% if page.url==item.url %}aria-current="page" {% endif %}>{{ item.text }}</a></li>
            {% endif %}
            {% endfor %}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>