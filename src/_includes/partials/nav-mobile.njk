<div class='mobile-nav'>
  <button
    class='mobile-nav__trigger | btn-reset'
    aria-label='Apri la Navigazione Principale'
    popovertarget='mobile-popover'
    type='button'
  >

    {% include "svg/bars-solid-full.svg" %}

  </button>

  <nav id='mobile-popover' popover aria-label='Navigazione principale'>

    <div class='mobile-popover__top-bar'>

      <div class='wrapper | py-s' data-variant='large'>

        <header class='mobile-nav__header | splitter'>
          <a class='site-head__brand' href='/' aria-label='Home'>
            <img
              eleventy:formats='svg'
              height='64'
              src='/assets/favicon/favicon.svg'
              alt=''
              fetchpriority='high'
              loading='eager'
            />
          </a>

          <button
            class='mobile-nav__close | btn-reset'
            popovertarget='mobile-popover'
            popovertargetaction='hide'
            aria-label='Chiudi menu'
          >

            {% include "svg/xmark-solid-full.svg" %}

          </button>
        </header>

      </div>
    </div>

    <div class='wrapper' data-variant='large'>
      <div class='mobile-menu-inner'>
        <ul class='mobile-nav-list' role='list'>
          {% for item in navigation.items %}
            {% if item.children and item.children.length %}
              <li class='mobile-nav-item'>
                <details class='mobile-accordion'>
                  <summary>
                    <span>{{ item.text }}</span>

                    {% include "svg/chevron-down-solid-full.svg" %}

                  </summary>

                  <ul class='mobile-sub-menu' role='list'>
                    {% for child in item.children %}
                      {% set isChildCurrent =(
                          child.url == '/' and page.url == '/'
                        ) or(
                          child.url != '/' and page.url and page.url.startsWith(
                            child.url
                          )
                        )
                      %}
                      <li>
                        <a
                          class=''
                          href='{{ child.url }}'
                          {% if isChildCurrent %}
                            aria-current="page"
                          {% endif %}
                        >{{ child.text }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              </li>
            {% else %}
              <li class='mobile-nav-item'>
                <a
                  class=''
                  href='{{ item.url }}'
                  {% if page.url==item.url %}
                    aria-current="page"
                  {% endif %}
                >{{ item.text }}</a>
              </li>
            {% endif %}
          {% endfor %}
          <li>
            <a
              class='button | mobile-nav-search'
              href='/archivio/'
              data-button-variant='primary'
              aria-label='Cerca nell&apos;archivio'
            >{% include "svg/magnifying-glass-solid-full.svg" %}Cerca in
              Archivio</a>
          </li>
        </ul>
      </div>
    </div>

  </nav>
</div>
