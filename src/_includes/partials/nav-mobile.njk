<div class='mobile-nav'>
  <button
    class='mobile-nav__trigger | btn-reset'
    aria-label='Apri la Navigazione Principale'
    popovertarget='mobile-popover'
    type='button'
  >

    <svg
      xmlns='http://www.w3.org/2000/svg'
      viewBox='0 0 640 640'
      fill='currentColor'
      aria-hidden='true'
    >
      <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
      <path
        d='M96 160C96 142.3 110.3 128 128 128L512 128C529.7 128 544 142.3 544 160C544 177.7 529.7 192 512 192L128 192C110.3 192 96 177.7 96 160zM96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320zM544 480C544 497.7 529.7 512 512 512L128 512C110.3 512 96 497.7 96 480C96 462.3 110.3 448 128 448L512 448C529.7 448 544 462.3 544 480z'
      />
    </svg>

  </button>

  <nav id='mobile-popover' popover aria-label='Navigazione principale'>

    <div class='mobile-popover__top-bar'>

      <div class='wrapper | py-s' data-variant='large'>

        <header class='mobile-nav__header | splitter'>
          <a class='site-head__brand' href='/' aria-label='Home'>
            <img
              eleventy:formats='svg'
              height='64'
              src='/assets/favicon/favicon.svg'
              alt=''
              fetchpriority='high'
              loading='eager'
            />
          </a>

          <button
            class='mobile-nav__close | btn-reset'
            popovertarget='mobile-popover'
            popovertargetaction='hide'
            aria-label='Chiudi menu'
          >
            <svg
              xmlns='http://www.w3.org/2000/svg'
              viewBox='0 0 640 640'
              fill='currentColor'
              aria-hidden='true'
            >
              <path
                d='M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z'
              />
            </svg>
          </button>
        </header>

      </div>
    </div>

    <div class='wrapper' data-variant='large'>
      <div class='mobile-menu-inner'>
        <ul class='mobile-nav-list' role='list'>
          {% for item in navigation.items %}
            {% if item.children and item.children.length %}
              <li class='mobile-nav-item'>
                <details class='mobile-accordion'>
                  <summary>
                    <span>{{ item.text }}</span>
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      viewBox='0 0 640 640'
                      fill='currentColor'
                      aria-hidden='true'
                      width='1em'
                      height='1em'
                    >
                      <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                      <path
                        d='M471.1 297.4C483.6 309.9 483.6 330.2 471.1 342.7L279.1 534.7C266.6 547.2 246.3 547.2 233.8 534.7C221.3 522.2 221.3 501.9 233.8 489.4L403.2 320L233.9 150.6C221.4 138.1 221.4 117.8 233.9 105.3C246.4 92.8 266.7 92.8 279.2 105.3L471.2 297.3z'
                      />
                    </svg>
                  </summary>

                  <ul class='mobile-sub-menu' role='list'>
                    {% for child in item.children %}
                      <li>
                        <a class='' href='{{ child.url }}' {% if page.url==child.url %}aria-current="page"{% endif %}>{{ child.text }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              </li>
            {% else %}
              <li class='mobile-nav-item'>
                <a class='' href='{{ item.url }}' {% if page.url==item.url %}aria-current="page"{% endif %}>{{ item.text }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>

  </nav>
</div>
