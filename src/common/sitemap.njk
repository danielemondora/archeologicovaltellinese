---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
excludeFromSitemap: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in collections.all %}
  {%- if page.url and page.data.excludeFromSitemap != true and not page.url.match('\.(css|js|scss|png|jpg|svg)$') -%}

  {%- if page.data.lastUpdated -%}
  {% set rawDate = page.data.lastUpdated %}
  {%- else -%}
  {% set rawDate = page.date %}
  {%- endif %}
  {%- set lastmod = rawDate.toISOString() if rawDate.toISOString else rawDate -%}

  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <lastmod>{{ lastmod | htmlDateFilter }}</lastmod>
    <changefreq>{{ page.data.changeFreq if page.data.changeFreq else "monthly" }}</changefreq>
  </url>
  {%- endif -%}
  {% endfor %}
</urlset>