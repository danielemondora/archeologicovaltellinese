---
layout: page.njk
title: Direttivo
permalink: /direttivo/
---
<section class="direttivo flow">

  <header class="flow">
    <h1>{{ direttivo.titolo }}</h1>
    <p class="direttivo__meta">
      In carica dal <strong>{{ direttivo.carica.dal }}</strong> al <strong>{{ direttivo.carica.al }}</strong>
    </p>
  </header>
  <div>
    <ul class="grid" data-layout="thirds" role="list">
      {% for membro in direttivo.membri %}
      <li class="card-membro flow flow-space-3xs">
        <span class="card-membro__ruolo text-step--1 text-primary uppercase font-bold">
          {{ membro.ruolo }}
        </span>
        <h2 class="card-membro__nome text-step-1">
          {{ membro.nome }}
        </h2>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

