---
pagination:
  data: pubblicazioni.notiziari
  size: 1
  alias: item

permalink: "/pubblicazioni/notiziario/item/{{ item.numero | slugify }}/index.html"

layout: page.njk

eleventyComputed:
  title: "Notiziario N°{{ item.numero }}"
  description: Scopri gli articoli e le ricerche del {{ title }} edito dall'Istituto Archeologico Valtellinese. Consulta l'indice analitico e scarica il volume.

eleventyNavigation:
  key: Item
  parent: Notiziario
---
<article class='notiziario-item | sidebar'>

  {# COLONNA SINISTRA (Meta, Copertina, Azioni) #}
  <div class='notiziario-item__meta | flow'>
    <header>
      <h1>
        Notiziario N°
        {{- item.numero -}}
        &nbsp;
        <span class='text-muted'>({{ item.anno }})</span>
      </h1>
    </header>

    <div class='notiziario-item__cover'>
      {% if item.immagine %}
        <img
          class='card__cover'
          src='{{ item.immagine }}'
          alt='Copertina del Notiziario N°{{ item.numero }}'
          loading='lazy'
          eleventy:ignore
        />
      {% else %}
        <div
          class='card__cover card__cover--placeholder'
          aria-hidden='true'
        ></div>
      {% endif %}
    </div>

    <nav class='cluster' aria-label='Azioni notiziario'>
      <a class='button' href='/pubblicazioni/notiziario/'>Tutti i notiziari</a>

      {% if item.download %}
        <a
          class='button'
          data-button-variant='primary'
          href='{{ item.download }}'
          download
        >
          Download
          <span class='visually-hidden'>del Notiziario
            N°{{- item.numero -}}</span>
        </a>
      {% endif %}
    </nav>

  </div>

  {# COLONNA DESTRA (Contenuto) #}
  <section class='notiziario-item__content' aria-labelledby='indice-titolo'>

    <h2 id='indice-titolo'>Indice</h2>

    <ul class='flow flow-space-m' role='list'>
      {% for articolo in item.indice %}
        <li class='notiziario-item__index-element'>
          <div class='flow flow-space-3xs'>

            <p class='text-step--1 text-muted'>Pag. {{ articolo.pagina }}</p>

            {% if articolo.autori %}
              <p class='text-step--1 text-muted'>
                {{ articolo.autori }}
              </p>
            {% endif %}

            <h3 class='text-step-0'>{{ articolo.titolo }}</h3>

          </div>

        </li>
      {% endfor %}
    </ul>

  </section>

</article>
