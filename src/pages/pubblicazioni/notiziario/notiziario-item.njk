---
pagination:
  data: pubblicazioni.notiziari
  size: 1
  alias: item
  addAllPagesToCollections: true

permalink: "/pubblicazioni/notiziario/item/{{ item.numero | slugify }}/index.html"

layout: page.njk

eleventyComputed:
  title:
    "Notiziario N°{{ item.numero }}"
  description:
    Scopri gli articoli e le ricerche del {{ title }} edito dall'Istituto Archeologico Valtellinese.
    Consulta l'indice analitico e scarica il volume.

eleventyNavigation:
  key: Item
  parent: Notiziario
---
<article class='notiziario-item | sidebar'>

  {# COLONNA SINISTRA (Meta, Copertina, Azioni) #}
  <div class='notiziario-item__meta | flow'>
    <header>
      <h1>
        Notiziario N°
        {{- item.numero -}}
        &nbsp;
        <span class='text-muted'>({{ item.anno }})</span>
      </h1>
    </header>

    <div class='notiziario-item__cover'>
      {% if item.immagine %}
        <img
          class='card__cover'
          src='{{ item.immagine }}'
          alt='Copertina del Notiziario N°{{ item.numero }}'
          loading='lazy'
          eleventy:ignore
        />
      {% else %}
        <div
          class='card__cover card__cover--placeholder'
          aria-hidden='true'
        ></div>
      {% endif %}
    </div>

    <nav class='cluster' aria-label='Azioni notiziario'>
      <a class='button' href='/pubblicazioni/notiziario/'>Notiziari</a>
      <a
        class='button'
        href='/archivio/'
      >{% include "svg/magnifying-glass-solid-full.svg" %}Cerca</a>

      {% if item.download %}
        <a
          class='button'
          data-button-variant='primary'
          href='{{ item.download }}'
          target='_blank'
          download
        >
          Download
          <span class='visually-hidden'>del Notiziario
            N°{{- item.numero -}}</span>
        </a>
      {% endif %}
    </nav>

  </div>

  {# COLONNA DESTRA (Contenuto) #}
  <section
    class='notiziario-item__content | flow'
    aria-labelledby='indice-titolo'
  >

    <h2 id='indice-titolo' data-pagefind-ignore>Indice</h2>

    <ul class='flow flow-space-m' role='list'>
      {% for articolo in item.indice %}
        <li class='notiziario-item__index-element' data-pagefind-body>

          <span class='visually-hidden'>Notiziario</span>

          <div class='flow flow-space-3xs'>
            <div
              class='splitter'
              style='flex-wrap: nowrap; align-items: baseline; gap: var(--space-s);'
            >

              <h3
                id='{{ articolo.titolo | slugify }}'
                class='text-step-0'
                data-pagefind-weight='5'
              >
                {{ articolo.titolo }}
              </h3>

              <p
                class='text-step--1 text-muted'
                style='flex-shrink: 0; text-align: right;'
              >
                Pag. {{ articolo.pagina }}
              </p>

            </div>

            {# AUTORI SOTTO #}
            {% set listaAutori = articolo.autori | separaAutori %}
            {% if listaAutori %}
              <p class='text-step--1 text-muted'>
                {% for autore in listaAutori %}
                  <span data-pagefind-filter='Autore'>
                    {{- autore -}}
                  </span>
                  {%- if not loop.last -%}&comma;{% endif -%}
                {% endfor %}
              </p>
            {% endif %}

          </div>
        </li>
      {% endfor %}
    </ul>

  </section>
</article>
